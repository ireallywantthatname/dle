{
  "name": "dle",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "bun -e \"const fs=require('fs');fs.mkdirSync('public',{recursive:true});fs.copyFileSync('node_modules/pdfjs-dist/build/pdf.worker.min.mjs','public/pdf.worker.min.mjs')\"",
    "ingest": "python3 scripts/ingest.py",
    "dev:media": "bun scripts/media-dev.ts",
    "dev": "bun scripts/dev.ts",
    "build": "bun run postinstall && bun --bun next build",
    "start": "bun --bun next start",
    "lint": "bun --bun biome check",
    "format": "bun --bun biome format --write",
    "typecheck": "bun --bun tsc --noEmit && bun --bun tsc --noEmit -p worker/tsconfig.json",
    "upload:r2": "bun scripts/upload-r2.ts",
    "deploy": "bun run build && bun --bun wrangler deploy"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.76.0",
    "next": "16.4.6",
    "pdfjs-dist": "^6.5.438",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@cloudflare/workers-types": "^5.20261119.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "wrangler": "^4.165.0"
  },
  "packageManager": "bun@1.4.4",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
